{
  "name": "web-components-zsf",
  "version": "0.0.7",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "unpkg": "dist/iife/index.js",
  "jsdelivr": "dist/iife/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js",
      "script": "./dist/iife/index.js"
    },
    "./preview-image": {
      "types": "./dist/preview-image.d.ts",
      "import": "./dist/es/preview-image.js",
      "require": "./dist/cjs/preview-image.js"
    },
    "./number-unit": {
      "types": "./dist/number-unit.d.ts",
      "import": "./dist/es/number-unit.js",
      "require": "./dist/cjs/number-unit.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "build": "eslint . --fix && vue-tsc -b && npm run build:es-cjs && npm run build:iife",
    "build:es-cjs": "vite build",
    "build:iife": "vite build --mode iife",
    "preview": "vite preview --host",
    "add": "node scripts/add-component.js",
    "remove": "node scripts/remove-component.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:native": "vite preview --open /test/native.html"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "lodash-es": "^4.17.21",
    "utils-zsf": "^0.0.4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@eslint/js": "^9.10.0",
    "@types/lodash": "^4.17.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-legacy": "^5.4.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/ui": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.2.1",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
